{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Restful-Booker API Tests",
		"description": "End-to-end CRUD and negative API tests for Restful-Booker created by Marcin Kollek.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Create Auth Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains auth token\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"token\");",
							"    pm.expect(jsonData.token).to.be.a(\"string\").and.not.be.empty;",
							"    pm.collectionVariables.set(\"auth_token\", jsonData.token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\" : \"admin\",\n    \"password\" : \"password123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/auth",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"auth"
					]
				}
			}
		},
		{
			"name": "2. Create Booking",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Booking ID is generated and data matches payload\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"bookingid\");",
							"    pm.expect(jsonData.booking.firstname).to.eql(\"Marcin\");",
							"    pm.expect(jsonData.booking.lastname).to.eql(\"Kollek\");",
							"    pm.expect(jsonData.booking.totalprice).to.eql(250);",
							"    pm.collectionVariables.set(\"booking_id\", jsonData.bookingid);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"firstname\" : \"Marcin\",\n    \"lastname\" : \"Kollek\",\n    \"totalprice\" : 250,\n    \"depositpaid\" : true,\n    \"bookingdates\" : {\n        \"checkin\" : \"2026-12-01\",\n        \"checkout\" : \"2026-12-05\"\n    },\n    \"additionalneeds\" : \"Breakfast\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/booking",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"booking"
					]
				}
			}
		},
		{
			"name": "3. Get Booking by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time is acceptable (< 1500ms)\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(1500);",
							"});",
							"",
							"pm.test(\"Retrieved booking matches created guest\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.firstname).to.eql(\"Marcin\");",
							"    pm.expect(jsonData.lastname).to.eql(\"Kollek\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/booking/{{booking_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"booking",
						"{{booking_id}}"
					]
				}
			}
		},
		{
			"name": "4. Update Booking",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Updated fields are reflected in response\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.totalprice).to.eql(320);",
							"    pm.expect(jsonData.additionalneeds).to.eql(\"Breakfast & Late Checkout\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Cookie",
						"value": "token={{auth_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"firstname\" : \"Marcin\",\n    \"lastname\" : \"Kollek\",\n    \"totalprice\" : 320,\n    \"depositpaid\" : true,\n    \"bookingdates\" : {\n        \"checkin\" : \"2026-12-01\",\n        \"checkout\" : \"2026-12-06\"\n    },\n    \"additionalneeds\" : \"Breakfast & Late Checkout\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/booking/{{booking_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"booking",
						"{{booking_id}}"
					]
				}
			}
		},
		{
			"name": "5. Delete Booking",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created (Restful-Booker delete spec)\", function () {",
							"    pm.response.to.have.status(201);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Cookie",
						"value": "token={{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/booking/{{booking_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"booking",
						"{{booking_id}}"
					]
				}
			}
		},
		{
			"name": "6. Verify Deleted Booking (Negative 404)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 404 Not Found after deletion\", function () {",
							"    pm.response.to.have.status(404);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/booking/{{booking_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"booking",
						"{{booking_id}}"
					]
				}
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "https://restful-booker.herokuapp.com"
		},
		{
			"key": "auth_token",
			"value": ""
		},
		{
			"key": "booking_id",
			"value": ""
		}
	]
}
